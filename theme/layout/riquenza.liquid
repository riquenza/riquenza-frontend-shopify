<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    <meta name="description" content="{{ page_description | default: 'Experience visibly BRIGHTER, FIRMER, and more LIFTED skin in just 30 DAYS with RIQUENZA.' | escape }}">
    <meta name="author" content="Riquenza">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <meta property="og:site_name" content="{{ shop.name }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:title" content="{{ page_title | escape }}">
    <meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">
    {%- if page_image -%}
      <meta property="og:image" content="https:{{ page_image | image_url }}">
    {%- endif -%}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&display=swap"
    >

    {{ 'riquenza.css' | asset_url | stylesheet_tag }}
    <script>
      window.Riq = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          cartUpdate: {{ routes.cart_update_url | json }},
          search: {{ routes.search_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }}
        },
        moneyFormat: {{ shop.money_format | json }},
        template: {{ template.name | json }}
      };
    </script>
    <script src="{{ 'riquenza.js' | asset_url }}" defer></script>
    <script src="{{ 'riq-components.js' | asset_url }}" defer></script>
    {%- if template.name == 'product' -%}
      <script src="{{ 'riq-product.js' | asset_url }}" defer></script>
    {%- endif -%}
    {%- if template.name == 'collection' or template.name == 'search' -%}
      <script src="{{ 'riq-collection.js' | asset_url }}" defer></script>
    {%- endif -%}

    {{ content_for_header }}
  </head>

  <body>
    <a class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:bg-white focus:px-4 focus:py-2" href="#MainContent">Skip to content</a>

    {% sections 'riq-header-group' %}

    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'riq-footer-group' %}

    {% section 'riq-cart-drawer' %}
    {% section 'riq-search-drawer' %}
  </body>
</html>
