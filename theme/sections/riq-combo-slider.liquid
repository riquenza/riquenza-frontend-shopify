{%- liquid
  assign collection = collections[section.settings.collection]
  if collection == blank
    assign collection = collections.all
  endif
-%}
<section class="riq-combos">
  {% render 'riq-section-head',
    eyebrow: section.settings.eyebrow,
    heading: section.settings.heading,
    subheading: section.settings.subheading
  %}
  <div class="riq-carousel">
    <button type="button" class="riq-carousel__ctrl riq-carousel__ctrl--prev" data-riq-scroll="prev" data-target="riq-combos-track" aria-label="Previous">{% render 'riq-icon', name: 'IoIosArrowBack', size: '24' %}</button>
    <button type="button" class="riq-carousel__ctrl riq-carousel__ctrl--next" data-riq-scroll="next" data-target="riq-combos-track" aria-label="Next">{% render 'riq-icon', name: 'IoIosArrowForward', size: '24' %}</button>
    <div class="riq-carousel__track scrollbar-hide" id="riq-combos-track" data-riq-scroller>
      {%- for product in collection.products limit: section.settings.products_to_show -%}
        <div class="riq-carousel__item riq-carousel__item--combo">
          {% render 'riq-combo-card', product: product, badge_label: section.settings.badge_label %}
        </div>
      {%- endfor -%}
    </div>
  </div>
  {%- if section.settings.cta_label != blank -%}
    <div class="riq-section-cta">
      {% render 'riq-btn', label: section.settings.cta_label, url: section.settings.cta_url %}
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .riq-section-combos .riq-carousel__item--combo {
    align-self: stretch;
    flex: 0 0 min(20.5rem, 72vw);
  }
  .riq-section-combos .riq-combo--kit {
    height: 100%;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Riquenza combo slider",
  "tag": "section",
  "class": "riq-section-combos",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Curated Routines" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Routines & Combo Kits" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Expert-crafted combinations for visible results — save more when you shop the complete routine." },
    { "type": "text", "id": "badge_label", "label": "Badge", "default": "Combo" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 12, "step": 1, "label": "Products", "default": 8 },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "View Kits & Combos" },
    { "type": "url", "id": "cta_url", "label": "Button link" }
  ],
  "presets": [{ "name": "Riquenza combo slider" }]
}
{% endschema %}
