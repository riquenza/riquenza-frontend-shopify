{%- paginate search.results by 9 -%}
<section class="riq-shop">
  <div class="riq-shop__inner">
    <h1 class="font-playfair" style="font-size:32px;margin:0 0 24px">Search{% if search.terms %} for “{{ search.terms }}”{% endif %}</h1>
    <form action="{{ routes.search_url }}" method="get" style="max-width:28rem;margin-bottom:32px">
      <input type="hidden" name="type" value="product">
      <input class="riq-search__input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search for product...">
    </form>
    {%- if search.performed -%}
      <p class="riq-shop__count">{{ search.results_count }} products</p>
      <ul class="riq-shop__grid">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            <li>{% render 'riq-product-card', product: item, badge_type: 'bestseller' %}</li>
          {%- endif -%}
        {%- else -%}
          <li style="grid-column:1/-1">No products found matching your criteria.</li>
        {%- endfor -%}
      </ul>
      {%- if paginate.pages > 1 -%}
        <nav class="riq-pager">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">‹</a>{%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>
            {%- else -%}<span class="{% if part.title == paginate.current_page %}is-current{% endif %}">{{ part.title }}</span>{%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}">›</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Riquenza search",
  "tag": "section",
  "class": "riq-section-search",
  "settings": []
}
{% endschema %}
