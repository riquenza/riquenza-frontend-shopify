<section class="riq-announcement" data-riq-rotator data-interval="4000">
  <div class="riq-announcement__inner">
    {%- for block in section.blocks -%}
      <div class="riq-announcement__item" data-riq-rotator-item {% unless forloop.first %}hidden{% endunless %} {{ block.shopify_attributes }}>
        {%- case block.settings.icon -%}
          {%- when 'gift' -%}{% render 'riq-icon', name: 'FaGift', size: '12', class: 'text-white/90' %}
          {%- when 'clock' -%}{% render 'riq-icon', name: 'FaClock', size: '12', class: 'text-white/90' %}
          {%- else -%}{% render 'riq-icon', name: 'FaCreditCard', size: '12', class: 'text-white/90' %}
        {%- endcase -%}
        <span class="riq-announcement__text">{{ block.settings.text }}</span>
      </div>
    {%- endfor -%}
    {%- if section.blocks.size > 1 -%}
      <div class="riq-announcement__dots">
        {%- for block in section.blocks -%}
          <button type="button" class="riq-announcement__dot{% if forloop.first %} is-active{% endif %}" data-riq-rotator-dot aria-label="Offer {{ forloop.index }}"></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Riquenza announcement",
  "class": "riq-section-announcement",
  "enabled_on": { "groups": ["header"] },
  "blocks": [
    {
      "type": "offer",
      "name": "Offer",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "gift", "label": "Gift" },
          { "value": "clock", "label": "Clock" },
          { "value": "card", "label": "Card" }
        ], "default": "gift" },
        { "type": "text", "id": "text", "label": "Text", "default": "Upto 50% OFF + Free Shipping" }
      ]
    }
  ],
  "presets": [{ "name": "Riquenza announcement" }]
}
{% endschema %}
