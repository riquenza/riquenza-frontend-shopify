<section class="riq-features{% if section.settings.compact %} riq-features--compact{% endif %}">
  {% render 'riq-section-head',
    eyebrow: section.settings.eyebrow,
    heading: section.settings.heading,
    subheading: section.settings.subheading
  %}
  <div class="riq-features__grid">
    {%- for block in section.blocks -%}
      <div class="riq-features__item" {{ block.shopify_attributes }}>
        <div class="riq-features__icon">
          {%- if block.settings.icon_asset != blank -%}
            <img src="{{ block.settings.icon_asset | asset_url }}" alt="{{ block.settings.label | escape }}" width="100" height="100">
          {%- endif -%}
        </div>
        <p class="riq-features__label">{{ block.settings.label }}</p>
        <p class="riq-features__cap">{{ block.settings.caption }}</p>
      </div>
    {%- endfor -%}
  </div>
  <div class="riq-features__meta">
    <span>Made in India</span>
    <span class="riq-features__dot"></span>
    <span>Lab Tested formulations</span>
    <span class="riq-features__dot"></span>
    <span>Safe for daily use</span>
  </div>
</section>

{% stylesheet %}
  .riq-section-features .riq-features__icon {
    align-items: center;
    background: #fff;
    border: 1px solid #4c433920;
    border-radius: 50%;
    box-shadow: 0 1px 2px #29262314;
    display: flex;
    height: 5.75rem;
    justify-content: center;
    margin: 0 auto;
    overflow: hidden;
    transition: box-shadow 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
    width: 5.75rem;
  }
  .riq-section-features .riq-features__item:hover .riq-features__icon {
    border-color: #950b244d;
    box-shadow: 0 8px 18px -10px #29262340;
    transform: translateY(-2px);
  }
  .riq-section-features .riq-features__icon img {
    border-radius: 50%;
    display: block;
    height: 4.625rem;
    margin: 0;
    object-fit: contain;
    width: 4.625rem;
  }
  @media (min-width: 768px) {
    .riq-section-features .riq-features__icon {
      height: 7.5rem;
      width: 7.5rem;
    }
    .riq-section-features .riq-features__icon img {
      height: 6rem;
      width: 6rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Riquenza feature row",
  "tag": "section",
  "class": "riq-section-features",
  "settings": [
    { "type": "checkbox", "id": "compact", "label": "Compact", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Promise" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Designed by Science. Desired by Skin." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Every Riquenza formula is crafted with clean, skin-first ingredients — and rigorously tested for safety." }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "icon_asset", "label": "Icon asset filename" },
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "text", "id": "caption", "label": "Caption" }
      ]
    }
  ],
  "presets": [{ "name": "Riquenza feature row" }]
}
{% endschema %}
