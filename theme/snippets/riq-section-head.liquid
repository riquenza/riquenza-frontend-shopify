<div class="riq-head">
  {%- if eyebrow != blank -%}
    <p class="riq-head__eyebrow">{{ eyebrow }}</p>
  {%- endif -%}
  <h2 class="riq-head__title">{{ heading }}</h2>
  <div class="riq-head__rule"></div>
  {%- if subheading != blank -%}
    <p class="riq-head__sub">{{ subheading }}</p>
  {%- endif -%}
</div>
