<section class="riq-pdp-offers" aria-labelledby="riq-pdp-offers-heading">
  <div class="riq-pdp-offers__glow" aria-hidden="true"></div>
  <div class="riq-pdp-offers__head">
    <span class="riq-pdp-offers__icon">{% render 'riq-icon', name: 'IoGift', size: '16' %}</span>
    <div class="riq-pdp-offers__titles">
      <h2 id="riq-pdp-offers-heading" class="riq-pdp-offers__title">Offers</h2>
      <span class="riq-pdp-offers__chip">Auto-applied</span>
    </div>
  </div>
  <div class="riq-pdp-offers__row">
    <p>
      <span class="riq-pdp-offers__emph">FREE shipping</span>
      on every order across India.
      <strong>No minimum cart value.</strong>
    </p>
  </div>
  <div class="riq-pdp-offers__row">
    <p>
      <span class="riq-pdp-offers__emph">Extra 10% off</span>
      when you checkout prepaid (UPI, cards, netbanking).
      <strong>Every order — no minimum cart value.</strong>
    </p>
  </div>
</section>
